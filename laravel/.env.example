# Modello di .env per FaPer3 v2. I valori sono quelli da PRODUZIONE/BETA:
# in sviluppo locale cambiare APP_ENV, APP_DEBUG, APP_URL, LOG_LEVEL e
# MAIL_MAILER (vedi commenti). Nessun segreto reale qui dentro.
#
# Il worker Python (dev_code/python) legge questo stesso file: DB_*, DB_PREFIX,
# APP_URL, APP_KEY (firma link di disiscrizione) e APP_TIMEZONE devono essere
# quelli corretti anche per lui.

APP_NAME=FaPer3
APP_ENV=production
# Generare con `php artisan key:generate`. Cambiarla invalida i link di
# disiscrizione già inviati (sono firmati con questa chiave).
APP_KEY=
# Sempre false fuori dallo sviluppo: con true gli errori mostrano codice e
# configurazione a chiunque.
APP_DEBUG=false
# URL pubblico senza slash finale (es. https://beta.faper3.it): usato anche nei
# link delle email (disiscrizione, pixel di apertura).
APP_URL=https://faper3.it
APP_TIMEZONE=Europe/Rome

APP_LOCALE=it
APP_FALLBACK_LOCALE=it
APP_FAKER_LOCALE=it_IT

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# daily = un file per giorno, conservato LOG_DAILY_DAYS giorni.
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
# In sviluppo: debug
LOG_LEVEL=warning

DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=autopostai
DB_USERNAME=
DB_PASSWORD=
# Prefisso tabelle: lo legge anche il worker Python.
DB_PREFIX=

# Connessione al DB v1 legacy, usata solo da `php artisan v1:import`.
# DB_LEGACY_HOST=127.0.0.1
# DB_LEGACY_PORT=3306
# DB_LEGACY_DATABASE=autopostai_v1_legacy
# DB_LEGACY_USERNAME=root
# DB_LEGACY_PASSWORD=
# DB_LEGACY_PREFIX=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Cookie di sessione solo su https (lasciare vuoto in sviluppo su http).
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# La coda serve alla generazione immagini (GenerateImageJob): in produzione
# deve girare un `php artisan queue:work`.
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Email dell'app (reset password). Con `log` le email NON partono: in
# produzione serve un SMTP reale. In sviluppo: MAIL_MAILER=log
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@faper3.it"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Notifiche push (WebPush) — genera con `php artisan webpush:vapid`.
# Cambiarle invalida le iscrizioni push esistenti.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT="mailto:notifiche@faper3.it"

# Servizio Python per la generazione immagini (dev_code/python/main.py),
# avviato da python/deploy/autopostai-python.sh su 127.0.0.1 (prod 8010,
# beta 8011: la 8000 è del servizio v1). In sviluppo: http://python:8000
PYTHON_SERVICE_URL=http://127.0.0.1:8010
