# Servizio immagini (FastAPI): nessuna chiave statica qui — ogni richiesta a
# /generate-image porta con sé la chiave dell'account (settings.openai_api_key),
# passata da App\Jobs\GenerateImageJob.
#
# Worker di pubblicazione (publisher/): questo file (montato come env_file) porta
# i SEGRETI GLOBALI del worker. Le credenziali DB e APP_URL arrivano invece dalla
# .env di Laravel montata come /laravel-env.
#
# NON mettere qui DB_HOST/DB_* o APP_*: le variabili di questo file vincono su
# quelle della .env di Laravel (load_dotenv non sovrascrive), e un DB_HOST
# sbagliato (es. host.docker.internal, che su Linux non esiste) scollega il
# worker dal database.

# Token Meta GLOBALE: un'unica app Meta gestita dall'admin, condivisa alle pagine
# via Business Manager. Da qui il worker ricava il page access token per ogni
# meta_page_id degli account. OBBLIGATORIO per pubblicare su Facebook/Instagram.
META_USER_ACCESS_TOKEN=

# Opzionali (hanno un default sensato in publisher/config.py):
# META_API_BASE_URL=https://graph.facebook.com/v21.0
# OPENAI_MODEL=gpt-4o-mini
# Timeout (secondi): chiamate HTTP ai provider (connessione, lettura) e LLM testo
# HTTP_CONNECT_TIMEOUT=10
# HTTP_READ_TIMEOUT=60
# OPENAI_TIMEOUT=90
# OPENAI_MAX_RETRIES=1
# PUBLISHER_DRY_RUN=0
# PUBLISHER_DEBUG=0
